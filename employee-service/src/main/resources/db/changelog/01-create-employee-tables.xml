<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="employee-001-create-employee" author="cursor-agent">
        <createTable tableName="employee">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)"/>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="department" type="VARCHAR(255)"/>
            <column name="designation" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="join_date" type="DATE"/>
            <column name="salary" type="BIGINT"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="employee" indexName="idx_employee_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="employee" indexName="idx_employee_tenant_user">
            <column name="tenant_id"/>
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="employee-002-create-attendance" author="cursor-agent">
        <createTable tableName="attendance">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="attendance_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="punch_in_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="punch_out_time" type="DATETIME"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="attendance" indexName="idx_attendance_tenant_employee_date">
            <column name="tenant_id"/>
            <column name="employee_id"/>
            <column name="attendance_date"/>
        </createIndex>
        <addForeignKeyConstraint
                baseTableName="attendance"
                baseColumnNames="employee_id"
                constraintName="fk_attendance_employee"
                referencedTableName="employee"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="employee-003-create-leave-request" author="cursor-agent">
        <createTable tableName="leave_request">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="leave_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(1000)"/>
            <column name="approved_by" type="VARCHAR(36)"/>
            <column name="approved_at" type="DATETIME"/>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="leave_request" indexName="idx_leave_request_tenant_employee">
            <column name="tenant_id"/>
            <column name="employee_id"/>
        </createIndex>
        <createIndex tableName="leave_request" indexName="idx_leave_request_tenant_status">
            <column name="tenant_id"/>
            <column name="status"/>
        </createIndex>
        <addForeignKeyConstraint
                baseTableName="leave_request"
                baseColumnNames="employee_id"
                constraintName="fk_leave_request_employee"
                referencedTableName="employee"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="employee-004-department-hierarchy-leave-balance" author="cursor-agent">
        <createTable tableName="department">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="department" indexName="idx_department_tenant_name">
            <column name="tenant_id"/>
            <column name="name"/>
        </createIndex>

        <addColumn tableName="employee">
            <column name="department_id" type="VARCHAR(36)"/>
        </addColumn>
        <addColumn tableName="employee">
            <column name="manager_id" type="VARCHAR(36)"/>
        </addColumn>
        <createIndex tableName="employee" indexName="idx_employee_tenant_department">
            <column name="tenant_id"/>
            <column name="department_id"/>
        </createIndex>
        <createIndex tableName="employee" indexName="idx_employee_manager_id">
            <column name="manager_id"/>
        </createIndex>

        <createTable tableName="leave_policy">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="leave_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="annual_allocation" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_accrual" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="max_carry_forward" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="blackout_start" type="DATE"/>
            <column name="blackout_end" type="DATE"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="leave_policy" columnNames="tenant_id,leave_type" constraintName="uk_leave_policy_tenant_type"/>

        <createTable tableName="leave_balance">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="leave_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="allocated" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="available" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="carry_forward" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="leave_balance" columnNames="tenant_id,employee_id,leave_type,year" constraintName="uk_leave_balance_scope"/>
        <createIndex tableName="leave_balance" indexName="idx_leave_balance_tenant_employee_year">
            <column name="tenant_id"/>
            <column name="employee_id"/>
            <column name="year"/>
        </createIndex>
        <addForeignKeyConstraint
                baseTableName="leave_balance"
                baseColumnNames="employee_id"
                constraintName="fk_leave_balance_employee"
                referencedTableName="employee"
                referencedColumnNames="id"/>

        <addColumn tableName="leave_request">
            <column name="requested_days" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="leave_request">
            <column name="alternate_approver_id" type="VARCHAR(36)"/>
        </addColumn>
        <createIndex tableName="leave_request" indexName="idx_leave_request_employee_dates_status">
            <column name="tenant_id"/>
            <column name="employee_id"/>
            <column name="status"/>
            <column name="start_date"/>
            <column name="end_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
